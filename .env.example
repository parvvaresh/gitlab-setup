# Copy to .env and fill in:  cp .env.example .env
# Any value left empty is asked interactively (if a terminal is attached).

# ───────────── GitLab server (install_gitlab.sh) ─────────────
# Public IP of the server
SERVER_IP=
# yes = real domain (DNS points to SERVER_IP), no = IP / local hostname
USE_DOMAIN=no
# Domain (e.g. gitlab.example.com) or local hostname (e.g. gitlab.local)
# NOTE: do not use HOSTNAME — bash sets it automatically.
GITLAB_HOSTNAME=gitlab.local
# Only when USE_DOMAIN=yes: enable HTTPS via Let's Encrypt
USE_LETSENCRYPT=yes
LE_EMAIL=
# Only when USE_DOMAIN=no: expose GitLab via "ip" or "hostname"
ACCESS_VIA=ip
# Optional: force external_url (otherwise computed from the values above)
EXTERNAL_URL=
# Create a backup right after installation
CREATE_BACKUP=yes
# Skip the confirmation prompts (needed for fully non-interactive runs)
ASSUME_YES=no
# Also install + register a GitLab Runner on this same server
INSTALL_RUNNER=no

# ───────────── GitLab Runner (install_gitlab_runner.sh) ─────────────
# GitLab URL the runner connects to (defaults to EXTERNAL_URL when run from install_gitlab.sh)
GITLAB_URL=
# Runner authentication token (glrt-...) from: Admin > CI/CD > Runners > New instance runner
# or Project > Settings > CI/CD > Runners > New project runner.
# Leave empty on the GitLab server itself to create an instance runner automatically.
RUNNER_TOKEN=
RUNNER_NAME=
# docker | shell
RUNNER_EXECUTOR=docker
RUNNER_DOCKER_IMAGE=alpine:latest
# Needed for docker-in-docker builds (docker build inside jobs)
RUNNER_DOCKER_PRIVILEGED=no
# Optional "host:ip" entries (comma-separated) added to job containers' /etc/hosts
RUNNER_DOCKER_EXTRA_HOSTS=
# Tags / untagged: only applied when the token is auto-created or a legacy registration token is used;
# for glrt- tokens set them in the GitLab UI when creating the runner.
RUNNER_TAGS=
RUNNER_RUN_UNTAGGED=yes
# Max jobs running in parallel on this machine
RUNNER_CONCURRENT=2
# Optional CA file if GitLab uses a self-signed certificate
RUNNER_TLS_CA_FILE=
